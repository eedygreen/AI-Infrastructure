name: data_segregation
conda_env: conda.yml

entry_points:
  main:
    parameters:
      input_artifact:
        description: Fully qualified name for the artifact
        type: str
      artifact_root:
        description: Root for the names of the produced artifacts
        type: str
      artifact_type:
        description: Type of the artifact to create
        type: str
        default: raw_data
      test_size: 
        description: Size to split the data
        type: float
      random_state:
        description: An integer number use to init random generator
        type: int
        default: 42
      stratify:
        description: Name of column to use for splitting
        type: str
        default: "null"

    command: >-
      python run.py --input_artifact {input_artifact} \
                            --artifact_root {artifact_root} \
                            --artifact_type {artifact_type} \
                            --test_size {test_size} \
                            --stratify {stratify}
